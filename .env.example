# .env.example — nusxasini ".env" deb saqlang va to'ldiring
PORT=3000
NODE_ENV=development

# Ixtiyoriy: aloqa formasidagi xabarlar Telegramingizga ham kelishi uchun
# 1) @BotFather orqali bot yarating va tokenni oling
# 2) Botga /start yozing, so'ng @userinfobot orqali o'z chat ID'ngizni bilib oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
